# Apollo configuration. Copy to .env and fill in the keys:
#   cp .env.example .env
# .env is gitignored. Never commit real keys.

# ── Required ────────────────────────────────────────────────
# Anthropic: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (realtime voice + transcription): https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Composio: https://platform.composio.dev → Settings → API Keys
COMPOSIO_API_KEY=ak_...

# ── Composio ────────────────────────────────────────────────
# Any stable ID for you; Composio stores your connected accounts under it.
APOLLO_COMPOSIO_USER_ID=vibhor
# Comma-separated toolkits Apollo may use (blank = all toolkits).
APOLLO_COMPOSIO_TOOLKITS=gmail,googlecalendar,slack,notion,github,googledrive

# ── Models (defaults shown) ─────────────────────────────────
APOLLO_AGENT_MODEL=claude-opus-5
# low | medium | high | xhigh | max
APOLLO_AGENT_EFFORT=high
APOLLO_POLISH_MODEL=claude-opus-5
APOLLO_REALTIME_MODEL=gpt-realtime-2.1
# marin | cedar | alloy | ash | ballad | coral | echo | sage | shimmer | verse
APOLLO_VOICE=marin
# minimal | low | medium | high | xhigh
APOLLO_REALTIME_EFFORT=low
APOLLO_REALTIME_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
APOLLO_DICTATION_MODEL=gpt-transcribe

# ── Dictation ───────────────────────────────────────────────
# true = light polish with Claude, false = raw transcript
APOLLO_DICTATION_POLISH=true
# Words the transcriber should get right (names, jargon), comma-separated
APOLLO_KEYWORDS=Apollo,Composio,Claude,Vibhor

# ── Personalization ─────────────────────────────────────────
APOLLO_USER_NAME=Vibhor

# ── Local server ────────────────────────────────────────────
APOLLO_HOST=127.0.0.1
APOLLO_PORT=8765
